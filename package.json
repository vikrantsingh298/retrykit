{
  "name": "retrykit",
  "version": "1.0.0",
  "description": "Zero-dependency, TypeScript-first async retry & resilience toolkit. Works on Node.js, Bun, Deno, and Edge runtimes.",
  "keywords": [
    "retry",
    "backoff",
    "exponential-backoff",
    "resilience",
    "timeout",
    "fallback",
    "typescript",
    "async",
    "edge",
    "zero-dependency"
  ],
  "author": "Vikrant Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikrantsingh298/retrykit.git"
  },
  "homepage": "https://github.com/vikrantsingh298/retrykit#readme",
  "bugs": {
    "url": "https://github.com/vikrantsingh298/retrykit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
